# MongoDB Atlas Connection String (Required for Cloud Deployment on Vercel / Render / Railway)
# Get a free forever M0 cluster at https://cloud.mongodb.com
# Remember: In MongoDB Atlas -> Network Access -> Add IP Address -> Allow Access from Anywhere (0.0.0.0/0)
KBE_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/koshbill_erp?retryWrites=true&w=majority

# Optional custom MongoDB database name (defaults to database in KBE_MONGODB_URI or "koshbill_erp")
KBE_MONGODB_DB_NAME=koshbill_erp
